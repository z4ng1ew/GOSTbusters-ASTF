<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ✅ ИСПРАВЛЕНО: Правильный родительский POM -->
    <parent>
        <groupId>org.gostbusters</groupId>
        <artifactId>gostbusters-astf</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>plugin-api</artifactId>
    <packaging>jar</packaging>
    <name>GOSTbusters ASTF Plugin API</name>
    <description>API for developing plugins for the ASTF framework</description>

    <!-- ✅ ИСПРАВЛЕНО: Удалены дублирующиеся версии из properties -->
    <properties>
        <!-- ✅ НЕТ: Все версии из родительского POM -->
    </properties>

    <dependencies>
        <!-- ✅ ИСПРАВЛЕНО: Зависимости от основного проекта -->
        <dependency>
            <groupId>org.gostbusters</groupId>
            <artifactId>gostbusters-astf</artifactId>
            <version>1.0-SNAPSHOT</version>
            <classifier>core</classifier> <!-- ✅ Если core выделен в отдельный JAR -->
            <scope>provided</scope> <!-- ✅ Только для компиляции -->
        </dependency>

        <!-- ✅ ИСПРАВЛЕНО: Зависимости с версиями через родительский POM -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <!-- ✅ НЕТ ВЕРСИИ: Будет из родительского dependencyManagement -->
        </dependency>
        
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <!-- ✅ НЕТ ВЕРСИИ: Будет из родительского dependencyManagement -->
        </dependency>

        <!-- ✅ ИСПРАВЛЕНО: Тестовые зависимости с версиями -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version> <!-- ✅ ИСПОЛЬЗУЕМ ИЗ РОДИТЕЛЯ -->
            <scope>test</scope>
        </dependency>
        
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version> <!-- ✅ ИСПОЛЬЗУЕМ ИЗ РОДИТЕЛЯ -->
            <scope>test</scope>
        </dependency>
        
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version> <!-- ✅ ИСПОЛЬЗУЕМ ИЗ РОДИТЕЛЯ -->
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                </configuration>
            </plugin>

            <!-- ✅ ДОБАВЛЕНО: Генерация sources JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- ✅ ДОБАВЛЕНО: Генерация javadoc JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>